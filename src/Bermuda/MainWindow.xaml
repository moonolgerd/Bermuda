<Window x:Class="Bermuda.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Bermuda" Height="768" Width="1280"
        Icon="Assets/app.ico">
    <Grid>
        <!-- Client title bar mode only: fills everything below the caption strip. The strip
             itself stays transparent so Windows can draw its caption buttons there. -->
        <Border x:Name="_fill" Background="#2d2d2d" Visibility="Collapsed" />
        <Grid x:Name="_root">
            <wv2:WebView2 x:Name="_webView" />
        </Grid>
    </Grid>
</Window>
