{
  "applications": [
    {
      "appId": "native-incidents",
      "name": "native-incidents",
      "title": "Native Incidents",
      "description": "Sample native side app (Bermuda.NativeApp) connected over gRPC on a named pipe. Acknowledges incidents it receives.",
      "type": "native",
      "details": {
        "path": "Bermuda.NativeApp.exe",
        "project": "../Bermuda.NativeApp/Bermuda.NativeApp.csproj"
      },
      "interop": {
        "intents": {
          "listensFor": {
            "ViewIncident": {
              "displayName": "View Incident (native)",
              "contexts": ["bermuda.incident"],
              "resultType": "bermuda.native.ack"
            }
          }
        },
        "userChannels": {
          "broadcasts": ["bermuda.native.ack"],
          "listensFor": ["bermuda.incident"]
        }
      }
    },
    {
      "appId": "fdc3-probe",
      "name": "fdc3-probe",
      "title": "FDC3 Probe",
      "description": "Sample FDC3 app (plain HTML, no Bermuda bundle) that lists the incidents sent to it.",
      "type": "web",
      "details": { "url": "/fdc3-probe.html" },
      "interop": {
        "userChannels": {
          "listensFor": ["bermuda.incident"]
        }
      }
    },
    {
      "appId": "bermuda-incidents",
      "name": "bermuda-incidents",
      "title": "Bermuda Incidents",
      "description": "Incident dashboard for the Bermuda Triangle: sortable table plus map.",
      "type": "web",
      "details": { "url": "/" },
      "interop": {
        "intents": {
          "listensFor": {
            "ViewIncident": {
              "displayName": "View Incident",
              "contexts": ["bermuda.incident"]
            }
          },
          "raises": {
            "ViewIncident": ["bermuda.incident"]
          }
        },
        "userChannels": {
          "broadcasts": ["bermuda.incident"],
          "listensFor": ["bermuda.incident"]
        }
      }
    }
  ]
}
