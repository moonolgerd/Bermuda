<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Unpackaged runs (dev, e2e) load the Windows App SDK from the app folder instead of needing a framework package. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- The SDK picks its native payload by RID. Keep the output path unchanged so existing tooling finds bin/Debug/<tfm>/Bermuda.exe. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AssemblyName>Bermuda</AssemblyName>
    <RootNamespace>Bermuda</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <!--
      MSIX packaging — override at the command line:
        dotnet msbuild src/Bermuda -t:CreateMsix -p:Configuration=Release -p:MsixVersion=1.2.3.0
      To sign, also pass a PFX (and its password if not the winapp default):
        -p:MsixSigningCert=<path\to\cert.pfx> -p:MsixSigningCertPassword=<password>
      Requires the winapp CLI: winget install Microsoft.winappcli
      To also emit an .appinstaller (auto-update source) next to the MSIX, pass both URLs:
        -p:MsixUrl=<where the .msix will be hosted> -p:AppInstallerUrl=<where the .appinstaller will be hosted>
      To pack a folder already published self-contained for win-x64, pass it and the publish step is skipped:
        -p:MsixInputDir=<publish output>
    -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <MsixVersion Condition="'$(MsixVersion)' == ''">1.0.0.0</MsixVersion>
    <MsixOutputDir Condition="'$(MsixOutputDir)' == ''">$(MSBuildProjectDirectory)\..\..\artifacts\msix\</MsixOutputDir>
    <MsixSigningCert Condition="'$(MsixSigningCert)' == ''" />
    <MsixSigningCertPassword Condition="'$(MsixSigningCertPassword)' == ''" />
    <MsixUrl Condition="'$(MsixUrl)' == ''" />
    <AppInstallerUrl Condition="'$(AppInstallerUrl)' == ''" />
    <MsixInputDir Condition="'$(MsixInputDir)' == ''" />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bermuda.ServiceDefaults\Bermuda.ServiceDefaults.csproj" />
  </ItemGroup>

  <!--
    IPC contract + TypeScript codegen
    =================================
    Bermuda.IpcContract is the single source of truth for the Web<->host contract:
    [IpcCommands] marks an interface of postMessage commands (see HostBridge), [IpcHostObject]
    marks a class projected via CoreWebView2.AddHostObjectToScript (see
    WindowScriptHost). Bermuda.IpcContract.SourceGenerator runs as an analyzer
    against this project — it discovers both attributes and writes the matching
    TypeScript into the frontend (src/ipc/__generated__, IpcOutputPath below —
    deliberately outside Relay's artifactDirectory, which deletes files it
    didn't generate).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Bermuda.IpcContract\Bermuda.IpcContract.csproj" />
    <ProjectReference Include="..\Bermuda.IpcContract.SourceGenerator\Bermuda.IpcContract.SourceGenerator.csproj"
                       OutputItemType="Analyzer"
                       ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <IpcOutputPath>$(MSBuildProjectDirectory)\..\Bermuda.Web\src\ipc\__generated__\ipc.d.ts</IpcOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="IpcOutputPath" />
  </ItemGroup>

  <!--
    ipc.d.ts is written by the generator as a side effect of CoreCompile
    running — it isn't a tracked MSBuild output. So if it's missing (deleted,
    or never generated) but no .cs file changed, MSBuild's incremental build
    sees the project as up to date and skips CoreCompile — and skips the
    generator with it — leaving the file missing after a "successful" build.
    Deleting MSBuild's own up-to-date marker forces CoreCompile to actually
    run whenever ipc.d.ts isn't there.
  -->
  <Target Name="EnsureIpcTypesGenerated" BeforeTargets="CoreCompile" Condition="!Exists('$(IpcOutputPath)')">
    <Delete Files="$(IntermediateOutputPath)$(MSBuildProjectFile).CoreCompileInputs.cache" Condition="Exists('$(IntermediateOutputPath)$(MSBuildProjectFile).CoreCompileInputs.cache')" />
  </Target>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- Also next to the exe: AppNotificationManager.Register reads the icon from disk for unpackaged runs. -->
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- FDC3 App Directory (AppD v2 "applications" shape) — see Bermuda.Fdc3.AppDirectory -->
    <Content Include="fdc3-appd.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- window.fdc3 bridge injected into every page; built from src/Bermuda.Web/src/fdc3/preload.ts (pnpm build:preload) -->
    <Content Include="Preload\fdc3-preload.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- tools/ holds file-based C# apps run by the packaging targets; they are not part of this assembly. -->
    <Compile Remove="tools\**" />
    <ProjectReference Include="..\Bermuda.Fdc3\Bermuda.Fdc3.csproj" />
    <ProjectReference Include="..\Bermuda.Fdc3.Grpc\Bermuda.Fdc3.Grpc.csproj" />
  </ItemGroup>

  <!--
    Native side apps are discovered from the FDC3 App Directory, fdc3-appd.json: every "type": "native" entry with
    details.path (its exe in the package) and details.project (the .csproj that builds it, relative to the file).
    Adding one is a one-line edit of that file; no project, manifest or script names it. tools/native-apps.cs (a file-based app) reads it.
  -->
  <Target Name="_ReadNativeApps">
    <Exec Command="dotnet run --file &quot;$(MSBuildProjectDirectory)\tools\native-apps.cs&quot; -- list &quot;$(MSBuildProjectDirectory)\fdc3-appd.json&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_NativeAppLine" />
    </Exec>
    <ItemGroup>
      <NativeApp Include="$([System.String]::Copy('%(_NativeAppLine.Identity)').Split('|')[0])" Condition="$([System.String]::Copy('%(_NativeAppLine.Identity)').Contains('|'))">
        <Exe>$([System.String]::Copy('%(_NativeAppLine.Identity)').Split('|')[1])</Exe>
        <Project>$([System.String]::Copy('%(_NativeAppLine.Identity)').Split('|')[2])</Project>
      </NativeApp>
    </ItemGroup>
  </Target>

  <!-- Publishes every native app's project (self-contained, win-x64) into NativeAppsPublishDir. CI calls this
       for tagged releases; CreateMsix calls it unless MsixInputDir is given. -->
  <Target Name="PublishNativeApps" DependsOnTargets="_ReadNativeApps">
    <Error Condition="'$(NativeAppsPublishDir)' == ''" Text="Set NativeAppsPublishDir." />
    <Error Condition="'%(NativeApp.Identity)' != '' and '%(NativeApp.Project)' == ''" Text="Native app '%(NativeApp.Identity)' in fdc3-appd.json has no details.project, so it cannot be built into the package." />
    <MSBuild Condition="'%(NativeApp.Project)' != ''" Projects="%(NativeApp.Project)" Targets="Restore;Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(NativeAppsPublishDir);PublishSingleFile=false;PublishReadyToRun=false" />
  </Target>

  <!--
    CreateMsix target
    =================
    1. dotnet publish (Bermuda, then every native app of fdc3-appd.json into the same folder) → self-contained win-x64 output, unless MsixInputDir is already that output
    2. Stage published files + AppxManifest.xml + Assets/
    3. winapp pack → Bermuda_<version>_x64.msix (signed when MsixSigningCert is set)

    Usage:
      dotnet msbuild src/Bermuda -t:CreateMsix -p:Configuration=Release
  -->
  <Target Name="CreateMsix" DependsOnTargets="_ReadNativeApps">

    <PropertyGroup>
      <_PublishDir Condition="'$(MsixInputDir)' == ''">$(MSBuildProjectDirectory)\..\..\artifacts\publish\</_PublishDir>
      <_PublishDir Condition="'$(MsixInputDir)' != ''">$([MSBuild]::EnsureTrailingSlash('$(MsixInputDir)'))</_PublishDir>
      <_StagingDir>$(MSBuildProjectDirectory)\..\..\artifacts\msix-staging\</_StagingDir>
      <_MsixPath>$(MsixOutputDir)Bermuda_$(MsixVersion)_x64.msix</_MsixPath>
    </PropertyGroup>

    <Error Condition="'$(MsixInputDir)' != '' and !Exists('$(MsixInputDir)')" Text="MsixInputDir '$(MsixInputDir)' does not exist. Publish the self-contained win-x64 app first." />

    <!-- 1. Publish self-contained win-x64, unless the caller already did. -->
    <MSBuild Condition="'$(MsixInputDir)' == ''" Projects="$(MSBuildProjectFile)" Targets="Publish" Properties="Configuration=$(Configuration);&#xD;&#xA;                         RuntimeIdentifier=win-x64;&#xD;&#xA;                         SelfContained=true;&#xD;&#xA;                         PublishDir=$(_PublishDir);&#xD;&#xA;                         PublishSingleFile=false;&#xD;&#xA;                         PublishReadyToRun=false" />

    <!-- The native side apps listed in fdc3-appd.json are more applications of this package: publish them into
         the same folder (their shared runtime and library files are identical, so the folder just merges). -->
    <MSBuild Condition="'$(MsixInputDir)' == ''" Projects="$(MSBuildProjectFullPath)" Targets="PublishNativeApps" Properties="Configuration=$(Configuration);NativeAppsPublishDir=$(_PublishDir)" />
    <Error Condition="'%(NativeApp.Identity)' != '' and !Exists('$(_PublishDir)%(NativeApp.Exe)')" Text="'$(_PublishDir)' has no %(NativeApp.Exe), the executable of native app '%(NativeApp.Identity)' in fdc3-appd.json. Publish its project (self-contained, win-x64) into the same folder." />

    <!-- 2. Prepare a clean staging directory -->
    <RemoveDir Directories="$(_StagingDir)" />
    <MakeDir Directories="$(_StagingDir);$(MsixOutputDir)" />

    <!-- 3. Copy published binaries into staging root -->
    <ItemGroup>
      <_PublishedFiles Include="$(_PublishDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PublishedFiles)" DestinationFolder="$(_StagingDir)%(RecursiveDir)" SkipUnchangedFiles="false" />

    <!-- 4. Stage the manifest — winapp finds it in the input folder as appxmanifest.xml.
         The Identity Version is stamped from MsixVersion: Windows compares that value, not the
         file name, to decide whether an .appinstaller update is newer. -->
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(MsixVersion)', '^\d+\.\d+\.\d+\.\d+$'))" Text="MsixVersion must have four parts (e.g. 1.2.3.0), got '$(MsixVersion)'." />
    <PropertyGroup>
      <_ManifestText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Package.appxmanifest'))</_ManifestText>
      <_ManifestText>$([System.Text.RegularExpressions.Regex]::Replace('$(_ManifestText)', '(?s)(&lt;Identity[^&gt;]*?Version=")[^"]*(")', '${1}$(MsixVersion)${2}'))</_ManifestText>
    </PropertyGroup>
    <WriteLinesToFile File="$(_StagingDir)appxmanifest.xml" Lines="$(_ManifestText)" Overwrite="true" />
    <!-- One <Application> per native app in fdc3-appd.json goes where the manifest has the @NATIVE_APPS@ marker. -->
    <Exec Command="dotnet run --file &quot;$(MSBuildProjectDirectory)\tools\native-apps.cs&quot; -- patch &quot;$(MSBuildProjectDirectory)\fdc3-appd.json&quot; &quot;$(_StagingDir)appxmanifest.xml&quot;" />

    <!-- 5. Copy asset images -->
    <ItemGroup>
      <_AssetFiles Include="$(MSBuildProjectDirectory)\Assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AssetFiles)" DestinationFolder="$(_StagingDir)Assets\%(RecursiveDir)" SkipUnchangedFiles="false" />

    <!-- 6. Pack (and optionally sign) with the winapp CLI. skip-pri keeps the package
         layout identical to the previous makeappx output. -->
    <PropertyGroup>
      <_WinappSignArgs Condition="'$(MsixSigningCert)' != ''">--cert &quot;$(MsixSigningCert)&quot;</_WinappSignArgs>
      <_WinappSignArgs Condition="'$(MsixSigningCert)' != '' and '$(MsixSigningCertPassword)' != ''">$(_WinappSignArgs) --cert-password &quot;$(MsixSigningCertPassword)&quot;</_WinappSignArgs>
      <_WinappSignArgs Condition="'$(MsixSigningCert)' == ''">--no-sign</_WinappSignArgs>
    </PropertyGroup>
    <Exec Command="winapp pack &quot;$(_StagingDir.TrimEnd('\'))&quot; --manifest &quot;$(_StagingDir)appxmanifest.xml&quot; --output &quot;$(_MsixPath)&quot; --skip-pri $(_WinappSignArgs)" WorkingDirectory="$(MSBuildProjectDirectory)" />

    <!-- 7. Optionally write the .appinstaller that points installed copies at this MSIX -->
    <PropertyGroup Condition="'$(AppInstallerUrl)' != ''">
      <_AppInstallerPath>$(MsixOutputDir)Bermuda.appinstaller</_AppInstallerPath>
      <_IdentityName>$([System.Text.RegularExpressions.Regex]::Match('$(_ManifestText)', 'Name="([^"]*)"').Groups[1].Value)</_IdentityName>
      <_IdentityPublisher>$([System.Text.RegularExpressions.Regex]::Match('$(_ManifestText)', 'Publisher="([^"]*)"').Groups[1].Value)</_IdentityPublisher>
      <_AppInstallerText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Bermuda.appinstaller.template'))</_AppInstallerText>
      <_AppInstallerText>$(_AppInstallerText.Replace('@VERSION@', '$(MsixVersion)').Replace('@NAME@', '$(_IdentityName)').Replace('@PUBLISHER@', '$(_IdentityPublisher)').Replace('@MSIX_URL@', '$(MsixUrl)').Replace('@APPINSTALLER_URL@', '$(AppInstallerUrl)'))</_AppInstallerText>
    </PropertyGroup>
    <Error Condition="'$(AppInstallerUrl)' != '' and '$(MsixUrl)' == ''" Text="AppInstallerUrl needs MsixUrl as well." />
    <WriteLinesToFile Condition="'$(AppInstallerUrl)' != ''" File="$(_AppInstallerPath)" Lines="$(_AppInstallerText)" Overwrite="true" />

    <Message Text="&#xA;MSIX: $(_MsixPath)&#xA;" Importance="high" />

  </Target>

</Project>
