<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the .appinstaller generated by the CreateMsix target (see Bermuda.csproj).
  The @-delimited values below are filled in from the manifest and the build properties.
-->
<AppInstaller xmlns="http://schemas.microsoft.com/appx/appinstaller/2018"
              Version="@VERSION@"
              Uri="@APPINSTALLER_URL@">
  <MainPackage Name="@NAME@"
               Publisher="@PUBLISHER@"
               Version="@VERSION@"
               ProcessorArchitecture="x64"
               Uri="@MSIX_URL@" />
  <UpdateSettings>
    <!-- Check on every launch; ask before installing, and never block the app from starting. -->
    <OnLaunch HoursBetweenUpdateChecks="0" ShowPrompt="true" UpdateBlocksActivation="false" />
    <AutomaticBackgroundTask />
  </UpdateSettings>
</AppInstaller>
