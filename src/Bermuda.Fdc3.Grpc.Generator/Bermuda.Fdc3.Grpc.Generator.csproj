<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time tool: checks the C# FDC3 contract (Bermuda.IpcContract) against
    ../Bermuda.Fdc3.Grpc/Protos/fdc3.proto (the source of truth, via protoc's descriptor set)
    and writes the gRPC glue into ../Bermuda.Fdc3.Grpc/Generated. Run by Bermuda.Fdc3.Grpc's build.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bermuda.IpcContract\Bermuda.IpcContract.csproj" />
  </ItemGroup>

</Project>
