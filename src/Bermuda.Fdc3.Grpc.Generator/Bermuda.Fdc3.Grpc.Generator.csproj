<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time tool run by Bermuda.Fdc3.Proto: turns Protos/fdc3.proto (via protoc's descriptor set) into the
    C# FDC3 contract (Bermuda.IpcContract) and the gRPC glue (Bermuda.Fdc3.Grpc). Depends on nothing it generates.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

</Project>
