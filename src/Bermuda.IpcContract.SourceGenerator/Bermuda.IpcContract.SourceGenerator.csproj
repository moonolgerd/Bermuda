<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0: matches the SDK's Roslyn 5.6 and the host project; no cross-TFM refs, so no RS1041. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- This generator intentionally writes a .d.ts file into the frontend project. -->
    <EnforceExtendedAnalyzerRules>false</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);RS1035</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <AssemblyName>Bermuda.IpcContract.SourceGenerator</AssemblyName>
    <RootNamespace>Bermuda.IpcContract.SourceGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
